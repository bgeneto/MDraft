# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Staged release output, bin/<os>/<arch>/. Reproducible with `npm run dist`.
bin

# Only the two screenshots the README embeds are part of the repository. The
# rest of this folder holds captures taken while comparing against Typora, which
# are working files: several megabytes of another application's interface.
#
# `docs/screenshots/*` rather than `docs/screenshots/` on purpose — excluding the
# directory itself makes git stop descending into it, and a `!` rule inside it
# would then have nothing to re-include.
docs/screenshots/*
!docs/screenshots/readme-main.png
!docs/screenshots/readme-preferences.png

# Remove samples 
docs/samples/*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
# Shared on purpose: without it rust-analyzer holds a cargo lock on
# src-tauri/target and `npm run dist` stalls on "Blocking waiting for file lock".
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
