# Staged release output, bin/<os>/<arch>/. Reproducible with `npm run dist`.
bin

# Only the screenshots the README embeds and the captures the landing page
# optimizer reads are part of the repository. The rest of this folder holds
# captures taken while comparing layouts and themes, which are working files.
#
# `docs/screenshots/*` rather than `docs/screenshots/` on purpose - excluding the
# directory itself makes git stop descending into it, and a `!` rule inside it
# would then have nothing to re-include.
docs/screenshots/*
!docs/screenshots/readme-markdown-light-renaissance.png
!docs/screenshots/readme-markdown-dark-system.png
# Sources for scripts/optimize-site-images.py -> site/assets/img/*.webp.
!docs/screenshots/auto-highlighting.webp
!docs/screenshots/builtin-ai-assistant.webp
!docs/screenshots/typst-ieee-conference-paper.webp
!docs/screenshots/typography-presets-implemented.png
!docs/screenshots/typography-presets-proposal.png
!docs/screenshots/math-light.png
!docs/screenshots/math-dark.png
!docs/screenshots/statusbar-p2.png

# Remove samples 
docs/samples/*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
# Shared on purpose: without it rust-analyzer holds a cargo lock on
# src-tauri/target and `npm run dist` stalls on "Blocking waiting for file lock".
!.vscode/settings.json
.VSCodeCounter/*
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Local browser automation artifacts from the MCP tooling; not part of the app.
.playwright-mcp/
