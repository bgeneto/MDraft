    "@asciidoctor/core": "4.2.1",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@typstyle/typstyle-wasm-bundler": "0.15.1",
    "asciimath2tex": "1.5.0",
    "codemirror-lang-typst": "0.6.0",
    "dompurify": "3.4.17",
    "emmet": "2.4.11",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "marked": "18.2.0",
    "mermaid": "12.3.0",
    "parse5": "8.1.1",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.10.0",
    "tex-fmt": "0.5.7-npm.1",
    "wasmtex": "https://github.com/corca-ai/wasmtex/releases/download/snapshot-f85a1d3cec1c0598/wasmtex-optional-monaco-d6a39bc.tgz"
