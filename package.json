{
  "name": "mdraft",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "A native Markdown, AsciiDoc, Typst and HTML editor with live preview and an optional AI assistant",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write \"src/**/*.{ts,js,css}\" \"site/**/*.{html,css,js}\" \"scripts/**/*.mjs\" \"*.{json,ts,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css}\" \"site/**/*.{html,css,js}\" \"scripts/**/*.mjs\" \"*.{json,ts,html}\"",
    "lint": "eslint src",
    "knip": "knip --include dependencies,unlisted",
    "preview": "vite preview",
    "tauri": "tauri",
    "dist": "node scripts/dist.mjs",
    "stage": "node scripts/stage-artifacts.mjs",
    "check:version": "node scripts/check-version.mjs",
    "icons": "node scripts/build-icons.mjs",
    "smoke": "node scripts/dom-smoke.mjs",
    "sync": "node scripts/scroll-sync-test.mjs",
    "sync:unit": "node scripts/scroll-sync-unit.mjs",
    "word-sync": "node scripts/word-sync-test.mjs",
    "autoclose": "node scripts/autoclose-test.mjs",
    "autoclose:unit": "node scripts/autoclose-unit.mjs",
    "completion:unit": "node scripts/completion-unit.mjs",
    "completion:latex:unit": "node scripts/completion-latex-unit.mjs",
    "latex:references:unit": "node scripts/latex-references-unit.mjs",
    "latex:diagnostics:unit": "node scripts/latex-diagnostics-unit.mjs",
    "latex:outline:unit": "node scripts/latex-outline-unit.mjs",
    "latex:word-map:unit": "node scripts/latex-word-map-unit.mjs",
    "pdf:map-worker:unit": "node scripts/pdf-page-worker-unit.mjs",
    "latex:sdk:unit": "node scripts/latex-sdk-unit.mjs",
    "latex:correspondence:unit": "node scripts/latex-correspondence-unit.mjs",
    "latex:preview": "node scripts/latex-preview-test.mjs",
    "latex:format:unit": "node scripts/latex-format-unit.mjs",
    "audit": "node scripts/audit-document.mjs",
    "math": "node scripts/math-render-check.mjs",
    "syntax": "node scripts/syntax-theme-test.mjs",
    "html": "node scripts/html-preview-test.mjs",
    "export": "node scripts/export-test.mjs",
    "export:paths:unit": "node scripts/export-paths-unit.mjs",
    "export:browser": "node scripts/export-browser-test.mjs",
    "pdf:visual": "node scripts/pdf-visual-check.mjs",
    "pdf:native": "node scripts/pdf-native-test.mjs",
    "typography": "node scripts/typography-test.mjs",
    "typography:unit": "node scripts/typography-unit.mjs",
    "shortcuts": "node scripts/shortcut-test.mjs",
    "menu": "node scripts/menu-test.mjs",
    "tabs": "node scripts/document-tabs-test.mjs",
    "favorites": "node scripts/favorites-test.mjs",
    "tabs:restore:unit": "node scripts/tabs-restore-unit.mjs",
    "typst:map:unit": "node scripts/typst-page-map-unit.mjs",
    "latex:sync:unit": "node scripts/latex-sync-unit.mjs",
    "latex:poc": "node scripts/latex-poc-test.mjs",
    "html:map:unit": "node scripts/html-source-map-unit.mjs",
    "block:map:unit": "node scripts/block-map-unit.mjs",
    "ai": "node scripts/ai-assistant-test.mjs",
    "ai:unit": "node scripts/ai-unit.mjs",
    "ai:live": "node scripts/ai-live-test.mjs",
    "read-aloud": "node scripts/read-aloud-test.mjs",
    "read-aloud:unit": "node scripts/read-aloud-unit.mjs",
    "recent": "node scripts/recent-menu-test.mjs",
    "test:sessions": "node scripts/sessions-test.mjs",
    "p0:unit": "node scripts/p0-unit.mjs",
    "filename:unit": "node scripts/filename-unit.mjs",
    "p0:lifecycle": "node scripts/p0-lifecycle-test.mjs",
    "single:instance": "node scripts/single-instance-test.mjs",
    "preview:zoom": "node scripts/preview-zoom-test.mjs",
    "preview:unit": "node scripts/preview-render-unit.mjs",
    "preview:worker:unit": "node scripts/preview-worker-unit.mjs",
    "preview:dom": "node scripts/preview-dom-test.mjs",
    "preview:perf": "node scripts/preview-performance-test.mjs",
    "typewriter": "node scripts/typewriter-test.mjs",
    "paste:convert": "node scripts/paste-convert-test.mjs",
    "paste": "node scripts/rich-paste-test.mjs",
    "asciidoc": "node scripts/asciidoc-test.mjs",
    "asciidoc:export:unit": "node scripts/asciidoc-export-unit.mjs",
    "image:syntax": "node scripts/image-syntax-test.mjs",
    "image:rules": "node scripts/image-rules-test.mjs",
    "links": "node scripts/link-navigation-test.mjs",
    "links:unit": "node scripts/link-target-unit.mjs",
    "typst:preview": "node scripts/typst-preview-test.mjs",
    "licence": "node scripts/licence-test.mjs",
    "spellcheck": "node scripts/spellcheck-test.mjs",
    "format:document": "node scripts/format-document-test.mjs",
    "images": "node scripts/image-paste-test.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "site": "node scripts/build-site.mjs",
    "site:serve": "node scripts/build-site.mjs --serve",
    "site:images": "python scripts/optimize-site-images.py --write",
    "site:images:check": "python scripts/optimize-site-images.py --check",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "node scripts/test-all.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@asciidoctor/core": "4.1.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.1",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@typstyle/typstyle-wasm-bundler": "0.15.1",
    "asciimath2tex": "1.5.0",
    "codemirror-lang-typst": "^0.6.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.10",
    "tex-fmt": "^0.5.7-npm.1",
    "wasmtex": "https://github.com/corca-ai/wasmtex/releases/download/snapshot-f85a1d3cec1c0598/wasmtex-optional-monaco-d6a39bc.tgz"
  },
  "overrides": {
    "wasmtex": {
      "pdfjs-dist": "$pdfjs-dist"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  }
}
