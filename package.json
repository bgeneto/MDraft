  "overrides": {
    "wasmtex": {
      "pdfjs-dist": "$pdfjs-dist"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "knip": "6.45.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
