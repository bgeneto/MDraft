    "latex:scheduler:unit": "node scripts/latex-scheduler-unit.mjs",
    "latex:outline:project:unit": "node scripts/latex-outline-project-unit.mjs",
    "latex:root": "node scripts/latex-root-test.mjs",
    "latex:format:unit": "node scripts/latex-format-unit.mjs",
    "audit": "node scripts/audit-document.mjs",
    "math": "node scripts/math-render-check.mjs",
    "syntax": "node scripts/syntax-theme-test.mjs",
