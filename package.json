{
  "name": "mdraft",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "A native Markdown, AsciiDoc, Typst and HTML editor with live preview and an optional AI assistant",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write \"src/**/*.{ts,js,css}\" \"site/**/*.{html,css,js}\" \"scripts/**/*.mjs\" \"*.{json,ts,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css}\" \"site/**/*.{html,css,js}\" \"scripts/**/*.mjs\" \"*.{json,ts,html}\"",
    "lint": "eslint src",
    "knip": "knip --include dependencies,unlisted",
    "preview": "vite preview",
    "tauri": "tauri",
    "dist": "node scripts/dist.mjs",
    "stage": "node scripts/stage-artifacts.mjs",
    "check:version": "node scripts/check-version.mjs",
    "icons": "node scripts/build-icons.mjs",
    "smoke": "node scripts/dom-smoke.mjs",
    "sync": "node scripts/scroll-sync-test.mjs",
    "sync:unit": "node scripts/scroll-sync-unit.mjs",
    "encoding:unit": "node scripts/encoding-unit.mjs",
    "encoding:dialog": "node scripts/encoding-dialog-test.mjs",
    "word-sync": "node scripts/word-sync-test.mjs",
    "autoclose": "node scripts/autoclose-test.mjs",
