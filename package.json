{
  "name": "mdraft",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "A Tauri 2 Markdown, Typst, HTML and AsciiDoc editor in the spirit of Typora",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dist": "node scripts/dist.mjs",
    "stage": "node scripts/stage-artifacts.mjs",
    "check:version": "node scripts/check-version.mjs",
    "smoke": "node scripts/dom-smoke.mjs",
    "word-sync": "node scripts/word-sync-test.mjs",
    "autoclose": "node scripts/autoclose-test.mjs",
    "autoclose:unit": "node scripts/autoclose-unit.mjs",
    "audit": "node scripts/audit-document.mjs",
    "math": "node scripts/math-render-check.mjs",
    "syntax": "node scripts/syntax-theme-test.mjs",
    "html": "node scripts/html-preview-test.mjs",
    "export": "node scripts/export-test.mjs",
    "typography": "node scripts/typography-test.mjs",
    "shortcuts": "node scripts/shortcut-test.mjs",
    "tabs": "node scripts/document-tabs-test.mjs",
    "tabs:restore:unit": "node scripts/tabs-restore-unit.mjs",
    "recent": "node scripts/recent-menu-test.mjs",
    "test:sessions": "node scripts/sessions-test.mjs",
    "paste:convert": "node scripts/paste-convert-test.mjs",
    "paste": "node scripts/rich-paste-test.mjs",
    "asciidoc": "node scripts/asciidoc-test.mjs",
    "asciidoc:export:unit": "node scripts/asciidoc-export-unit.mjs",
    "image:syntax": "node scripts/image-syntax-test.mjs",
    "typst:preview": "node scripts/typst-preview-test.mjs",
    "licence": "node scripts/licence-test.mjs",
    "spellcheck": "node scripts/spellcheck-test.mjs",
    "images": "node scripts/image-paste-test.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "node scripts/test-all.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@asciidoctor/core": "4.1.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.1",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "asciimath2tex": "1.5.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-typst": "^0.6.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "parse5": "^7.3.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
