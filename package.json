    "test": "node scripts/test-all.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "repo:hygiene": "node scripts/repo-hygiene.mjs",
    "repo:hygiene:history": "node scripts/repo-hygiene.mjs --history",
    "repo:hygiene:test": "node scripts/repo-hygiene-test.mjs",
    "security:scan": "node scripts/security-scan.mjs --staged",
    "security:history": "node scripts/security-scan.mjs --history",
    "security:self-test": "node scripts/security-scan.mjs --self-test",
